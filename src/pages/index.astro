---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';

import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  CU_11_DESCRIPTION,
  F_11_DESCRIPTION,
  REC_11_DESCRIPTION
} from '../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<h1>REPORTES DE PRÁCTICAS</h1>

			<p>
				En este blog encontrarás mis reportes de las prácticas realizadas
				en el curso de Tópicos Avanzados de Programación de la carrera de
				Ingeniería en Sistemas Computacionales del Tecnológico Superior de Zapopan.
			</p>

			<p>
				Los reportes correspondientes a las prácticas son los siguientes:
			</p>

			<ul>
				<Card
					title="CALIFICACIONES DE UN ALUMNO"
					body={CU_11_DESCRIPTION}
					href="blog/cu11"
					icon="☭"
				/>
				<br />
				<Card
					title="FACTORIALES "
					body={F_11_DESCRIPTION}
					href="blog/f11"
					icon="☭"
				/>
				<br />
				<Card
					title="RAICES DE UNA ECUACION CUADRATICA "
					body={REC_11_DESCRIPTION}
					href="blog/rec11"
					icon="☭"
				/>
				<br />
			</ul>

			<p>
				Puedes revisar mis demás repositorios en mi GitHub
				<a href="https://github.com/ArZz04">ArZz04</a>.
			</p>
		</main>

		<Footer />
	</body>
</html>